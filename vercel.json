{
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/me",
      "destination": "/api/game?route=me"
    },
    {
      "source": "/api/auth",
      "destination": "/api/game?route=auth"
    },
    {
      "source": "/api/daily/start",
      "destination": "/api/game?route=daily-start"
    },
    {
      "source": "/api/daily/finish",
      "destination": "/api/game?route=daily-finish"
    },
    {
      "source": "/api/leaderboard",
      "destination": "/api/game?route=leaderboard"
    },
    {
      "source": "/api/auth/everywhere",
      "destination": "/api/game?route=auth-everywhere"
    },
    {
      "source": "/api/push/key",
      "destination": "/api/game?route=push-key"
    },
    {
      "source": "/api/push/subscribe",
      "destination": "/api/game?route=push-subscribe"
    },
    {
      "source": "/api/report",
      "destination": "/api/game?route=report"
    },
    {
      "source": "/api/health",
      "destination": "/api/game?route=health"
    },
    {
      "source": "/api/cron/reminders",
      "destination": "/api/game?route=cron-reminders"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
